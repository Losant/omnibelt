{
  "name": "omnibelt",
  "description": "A utility belt that normalizes and wraps `Ramda` and `Lodash/FP`.",
  "version": "4.0.1",
  "license": "MIT",
  "main": "src/index.js",
  "repository": "git@github.com/Losant/omnibelt.git",
  "author": "@Losant",
  "contributors": [
    {
      "name": "Rob Hilgefort",
      "email": "rjhilgefort@gmail.com",
      "web": "rob.hilgefort.me"
    }
  ],
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.33.2",
  "scripts": {
    "reinstall": "rm -rf node_modules && pnpm install",
    "lint": "eslint . --ext .js",
    "lint:fix": "pnpm lint --fix",
    "lint:staged": "lint-staged",
    "test": "jest --verbose",
    "test:watch": "pnpm test --watch -o",
    "ramda:index": "node ./scripts/gen-ramda-index-file.js",
    "docs": "pnpm docs:open",
    "predocs:build": "./scripts/gen-3rd-party-docs.js",
    "docs:build": "jsdoc -c jsdoc.json",
    "docs:open": "open ./docs/index.html"
  },
  "lint-staged": {
    "*.js": "eslint"
  },
  "dependencies": {
    "lodash": "^4.18.1",
    "ramda": "^0.32.0",
    "string-format": "^2.0.0",
    "stringify-object": "^3.3.0"
  },
  "devDependencies": {
    "@losant/eslint-config-losant": "^2.1.0",
    "docdash": "^2.0.2",
    "expect": "^30.3.0",
    "fs-extra": "^11.3.4",
    "handlebars": "^4.7.9",
    "husky": "^9.1.7",
    "jest": "^30.3.0",
    "jsdoc": "^4.0.5",
    "lint-staged": "^16.4.0",
    "present": "^1.0.0"
  },
  "eslintConfig": {
    "extends": "@losant/eslint-config-losant/env/node",
    "env": {
      "jest": true
    },
    "rules": {
      "valid-jsdoc": 0
    }
  }
}
